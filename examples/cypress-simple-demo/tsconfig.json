{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "cypress",
      "node"
    ],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "cypress/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cypress/videos",
    "cypress/screenshots"
  ],
  "references": [
    {
      "path": "../../packages/integrations/cypress"
    }
  ]
}

