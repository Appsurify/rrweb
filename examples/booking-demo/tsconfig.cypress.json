{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "lib": ["es5", "dom"],
    "sourceMap": true,
    "types": ["cypress", "node"]
  },
  "include": [
    "tests/cypress/**/*.ts",
    "cypress.config.ts",
    "cypress/plugins/**/*.ts",
    "cypress/support/**/*.ts"

  ]
}
