{
  "name": "@appsurify-testmap/rrweb-cypress-plugin",
  "version": "2.1.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rrweb"
  ],
  "scripts": {
    "prebuild": "yarn workspace @appsurify-testmap/rrweb-record run build",
    "build": "yarn turbo run prepublish",
    "prepublish": "yarn prebuild && tsup-node"
  },
  "homepage": "https://github.com/rrweb-io/rrweb/tree/main/packages/@rrweb/utils#readme",
  "bugs": {
    "url": "https://github.com/rrweb-io/rrweb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrweb-io/rrweb.git"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./reporter": {
      "import": "./dist/reporter.mjs",
      "require": "./dist/reporter.js",
      "types": "./dist/reporter.d.ts"
    }
  },
  "files": [
    "dist",
    "Readme.md"
  ],
  "devDependencies": {
    "@types/debug": "^4.1.7",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.21",
    "cypress": "^14.3.2",
    "tsup": "^6.6.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@appsurify-testmap/rrweb": "^2.1.3-alpha.2",
    "@appsurify-testmap/rrweb-plugin-sequential-id-record": "^2.1.3-alpha.2",
    "@appsurify-testmap/rrweb-snapshot": "^2.1.3-alpha.2",
    "@appsurify-testmap/rrweb-types": "^2.1.3-alpha.2"
  }
}
