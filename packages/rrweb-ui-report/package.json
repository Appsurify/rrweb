{
  "name": "@appsurify-testmap/rrweb-ui-report",
  "version": "2.1.1-alpha.6",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rrweb",
    "@appsurify-testmap/rrweb-ui-report"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -noEmit && vite build",
    "check-types": "tsc -noEmit",
    "prepublish": "npm run build",
    "lint": "yarn eslint src/**/*.ts",
    "demo": "node ./scripts/convert.js ./tmp/demo.json ./tmp/coverage.json",
    "debug": "node ./scripts/convert.js ./tmp/debug.json ./tmp/coverage-debug.json"
  },
  "bin": {
    "ui-report": "./scripts/convert.js"
  },
  "homepage": "https://github.com/rrweb-io/rrweb/tree/main/packages/@rrweb/utils#readme",
  "bugs": {
    "url": "https://github.com/rrweb-io/rrweb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrweb-io/rrweb.git"
  },
  "license": "MIT",
  "main": "./dist/rrweb-ui-report.umd.cjs",
  "module": "./dist/rrweb-ui-report.js",
  "browser": "./dist/rrweb-ui-report.umd.cjs",
  "unpkg": "./dist/rrweb-ui-report.umd.cjs",
  "typings": "./dist/rrweb-ui-report.d.ts",
  "exports": {
    ".": {
      "require": "./dist/rrweb-ui-report.umd.cjs",
      "import": "./dist/rrweb-ui-report.js",
      "types": "./dist/rrweb-ui-report.d.ts"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@appsurify-testmap/rrweb-types": "^2.1.1-alpha.6"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^5.2.8",
    "vite-plugin-dts": "^3.8.1"
  }
}
